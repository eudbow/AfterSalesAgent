# Only loaded when you explicitly pass --env-file .env.
# Fill the key locally. Never paste it into chat, frontend, or committed files.
AFTERSALES_RUNTIME=langgraph
AFTERSALES_BACKEND=deepseek
# Checked against official docs on 2026-10-19; override if the service changes.
AFTERSALES_MODEL_NAME=deepseek-flash
AFTERSALES_MODEL_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Non-thinking mode is explicitly set by the adapter.
AFTERSALES_MODEL_TIMEOUT_SECONDS=25
AFTERSALES_MODEL_MAX_OUTPUT_TOKENS=1024
AFTERSALES_MODEL_TEMPERATURE=0
AFTERSALES_MAX_MODEL_CALLS=12
AFTERSALES_MAX_TOOL_CALLS=20
AFTERSALES_MAX_ACTIVE_SECONDS=120
AFTERSALES_MAX_TOKENS=24000
AFTERSALES_MAX_TURN_MODEL_CALLS=6
AFTERSALES_MAX_TURN_TOOL_CALLS=10
AFTERSALES_MAX_TURN_ACTIVE_SECONDS=30
AFTERSALES_MAX_TURN_TOKENS=12000

# E2: native or local stdio mcp; defaults stay native.
AFTERSALES_TOOL_TRANSPORT=native
AFTERSALES_KNOWLEDGE_TRANSPORT=native

# E3 step 1: opt in explicitly; default is no Skill.
# AFTERSALES_SKILL_ID=after-sales-workflow
# AFTERSALES_SKILL_VERSION=1.0.0
# Use released only after a manual activation in the same data directory.
